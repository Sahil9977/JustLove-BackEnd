PORT=5000
NODE_ENV=development

# MongoDB Atlas: Database > Connect > Drivers > copy the string, then put your DB user's password in it
# (if the password has special characters like @ # / : URL-encode them) and add the DB name "justlove" before the "?"
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/justlove?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string
# Frontend address(es) allowed to call this API, comma separated (dev: Vite, prod: your site)
CLIENT_ORIGIN=http://localhost:5173

# Used ONLY by `npm run seed` (stored hashed). Remove LOVE_CODE from this file after seeding.
LOVE_CODE=choose-your-secret-love-code
OWNER_EMAIL=you@example.com

# Email for the "forgot love code" one-time code (Gmail: use an App Password).
# If left empty in development, the code is printed in this terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Set to 1 when hosted behind a proxy (Render, Railway, Heroku...) so rate limiting sees real IPs
TRUST_PROXY=0
